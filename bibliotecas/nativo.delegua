    @definicao(simbolo = "delegua_ffi_cgdCurlExecutar")
    curlExecutar(sessao: qualquer): dicionario;
    @definicao(simbolo = "delegua_ffi_cgdCurlLote")
    curlLote(sessoes: qualquer[]): dicionario[];
    @definicao(simbolo = "delegua_ffi_cgdCurlOpcoes")
