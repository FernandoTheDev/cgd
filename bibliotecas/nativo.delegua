// Ponte gerenciada para bibliotecas C do CGD. ABI explícita, sem ponteiros crus.
@definicao(biblioteca = "cgd-runtime", abi = "delegua")
classe estrangeira Primitivas {
    @definicao(simbolo = "delegua_ffi_cgdCurlCriar")
    curlCriar(): qualquer;
    @definicao(simbolo = "delegua_ffi_cgdCurlFechar")
    curlFechar(sessao: qualquer): vazio;
    @definicao(simbolo = "delegua_ffi_cgdCurlResetar")
    curlResetar(sessao: qualquer): qualquer;
    @definicao(simbolo = "delegua_ffi_cgdCurlOpcao")
