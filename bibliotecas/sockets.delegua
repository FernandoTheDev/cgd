// TCP IPv4 síncrono e assíncrono, sem descritores ou ponteiros expostos.
classe Conexao {
    privado {
        _recurso: qualquer
    }

    construtor(recurso: qualquer) {
        isto._recurso = recurso
    }

    enviarAsync(dados: texto, timeout: inteiro = 30000): Promessa < inteiro > {
        retorna importar("cgd:assincrono").OperacoesAssincronas.tcpEnviar(isto._recurso,
            dados, timeout)
    }

    receberAsync(limite: inteiro = 65536, timeout: inteiro = 30000): Promessa < texto > {
        retorna importar("cgd:assincrono").OperacoesAssincronas.tcpReceber(isto._recurso,
            limite, timeout)
    }

    enviar(dados: texto, timeout: inteiro = 30000): inteiro {
        var nativo: qualquer = importar("cgd:nativo").Primitivas
        retorna nativo.socketEnviar(isto._recurso, dados, timeout)
    }

    receber(limite: inteiro = 65536, timeout: inteiro = 30000): texto {
        var nativo: qualquer = importar("cgd:nativo").Primitivas
        retorna nativo.socketReceber(isto._recurso, limite, timeout)
    }

    lerHTTP(maxCabecalhos: inteiro = 16384, maxCorpo: inteiro = 1048576, timeout: inteiro = 10000): dicionario {
        var nativo: qualquer = importar("cgd:nativo").Primitivas
        retorna nativo.httpReceber(isto._recurso, maxCabecalhos, maxCorpo, timeout)
    }

    responderHTTP(status: inteiro, cabecalhos: dicionario, corpo: texto, head: logico = falso,
        timeout: inteiro = 10000): vazio {
        var nativo: qualquer = importar("cgd:nativo").Primitivas
        nativo.httpEnviar(isto._recurso, status, cabecalhos, corpo, head, timeout)
    }

    portaLocal(): inteiro {
        var nativo: qualquer = importar("cgd:nativo").Primitivas
        retorna nativo.socketPorta(isto._recurso)
    }

    fechar(): vazio {
        var nativo: qualquer = importar("cgd:nativo").Primitivas
        nativo.socketFechar(isto._recurso)
    }

    destrutor(): vazio {
        isto.fechar()
    }
}

classe OuvinteTCP {
    privado {
        _recurso: qualquer
    }

    construtor(endereco: texto = "127.0.0.1", porta: inteiro = 0) {
        var nativo: qualquer = importar("cgd:nativo").Primitivas
        isto._recurso = nativo.socketAbrir(endereco, porta, verdadeiro, 30000)
    }

    aceitarAsync(timeout: inteiro = 30000): Promessa < Conexao > {
        retorna receberConexao(importar("cgd:assincrono").OperacoesAssincronas.tcpAceitar(isto._recurso,
            timeout))
    }

    aceitar(timeout: inteiro = 1000): qualquer {
        var nativo: qualquer = importar("cgd:nativo").Primitivas
        var recurso: qualquer = nativo.socketAceitar(isto._recurso, timeout)
        se recurso == nulo {
            retorna nulo
        }
        retorna Conexao(recurso)
    }

    portaLocal(): inteiro {
        var nativo: qualquer = importar("cgd:nativo").Primitivas
        retorna nativo.socketPorta(isto._recurso)
    }

    fechar(): vazio {
        var nativo: qualquer = importar("cgd:nativo").Primitivas
        nativo.socketFechar(isto._recurso)
    }

    destrutor(): vazio {
        isto.fechar()
    }
}

funcao conectar(endereco: texto, porta: inteiro, timeout: inteiro = 30000): Conexao {
    var nativo: qualquer = importar("cgd:nativo").Primitivas
    retorna Conexao(nativo.socketAbrir(endereco, porta, falso, timeout))
}

funcao conectarAsync(endereco: texto, porta: inteiro, timeout: inteiro = 30000): Promessa < Conexao > {
    retorna receberConexao(importar("cgd:assincrono").OperacoesAssincronas.tcpConectar(endereco,
        porta, timeout))
}

assincrona funcao receberConexao(operacao: Promessa < qualquer >): Conexao {
    tente {
        retorna Conexao(aguardar operacao)
    } pegue (erro: Excecao) {
        operacao.cancelar()
        tente {
            const recurso: qualquer = aguardar operacao
            importar("cgd:nativo").Primitivas.socketFechar(recurso)
        } pegue (ignorado: Excecao) {
        }
        falhar erro
    }
}

classe SocketUDP {
    privado {
        _recurso: qualquer
    }

    construtor(endereco: texto = "127.0.0.1", porta: inteiro = 0) {
        var nativo: qualquer = importar("cgd:nativo").Primitivas
        isto._recurso = nativo.socketUdpAbrir(endereco, porta)
    }

    enviarPara(dados: texto, endereco: texto, porta: inteiro): inteiro {
        var nativo: qualquer = importar("cgd:nativo").Primitivas
        retorna nativo.socketUdpEnviar(isto._recurso, dados, endereco, porta)
    }

    receberDe(limite: inteiro = 65536, timeout: inteiro = 10000): dicionario {
        var nativo: qualquer = importar("cgd:nativo").Primitivas
        retorna nativo.socketUdpReceber(isto._recurso, limite, timeout)
    }

    portaLocal(): inteiro {
        var nativo: qualquer = importar("cgd:nativo").Primitivas
        retorna nativo.socketPorta(isto._recurso)
    }

    fechar(): vazio {
        var nativo: qualquer = importar("cgd:nativo").Primitivas
        nativo.socketFechar(isto._recurso)
    }

    destrutor(): vazio {
        isto.fechar()
    }
}

funcao abrirUDP(endereco: texto = "127.0.0.1", porta: inteiro = 0): SocketUDP {
    retorna SocketUDP(endereco, porta)
}

funcao resolverDNS(host: texto, familia: texto = "qualquer"): texto[] {
    var nativo: qualquer = importar("cgd:nativo").Primitivas
    retorna nativo.socketResolverDns(host, familia)
}
