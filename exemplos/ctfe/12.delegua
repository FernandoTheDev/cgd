//$
//! Maior sequencia de Collatz ate 1000: 178
//>puro
funcao modulo_dois(n: qualquer): qualquer {
    retorne (n & 1) == 0
}

//>puro
funcao passo_collatz(n: qualquer): qualquer {
    se modulo_dois(n) {
        retorne n / 2
    }

    retorne (3 * n) + 1
}

//>puro
funcao calcular_passos_collatz(n: qualquer): qualquer {
    var passos: numero = 0
    var atual: qualquer = n

    enquanto atual > 1 {
        atual = passo_collatz(atual)
        passos = passos + 1
    }

    retorne passos
}

//>puro
funcao estresse_ctfe(limite: qualquer): qualquer {
    var maior_sequencia: numero = 0
    var i: numero = 1

    enquanto i <= limite {
        var passos_atuais: qualquer = calcular_passos_collatz(i)

        se passos_atuais > maior_sequencia {
            maior_sequencia = passos_atuais
        }

        i = i + 1
    }

    retorne maior_sequencia
}

escreva("Maior sequencia de Collatz ate 1000: ", estresse_ctfe(1000))
