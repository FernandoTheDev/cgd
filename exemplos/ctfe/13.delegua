//$
//! Resultado principal: 2204.1\nResultado secundario: 1813.8\nTotal: 4017.9\nPrimo 97? verdadeiro\nPalindromo 909? verdadeiro

//>puro
funcao eh_par(n: qualquer): qualquer {
    retorne(n & 1) == 0
}

//>puro
funcao colapso_collatz(n: qualquer): qualquer {
    se eh_par(n) {
        retorne n / 2
    }

    retorne(n * 3) + 1
}

//>puro
funcao passos_collatz(n: qualquer): qualquer {
    var passos: numero = 0
    var atual: qualquer = n
    enquanto atual > 1 {
        atual = colapso_collatz(atual)
        passos = passos + 1
    }

    retorne passos
}

//>puro
funcao fibonacci_iterativo(n: qualquer): qualquer {
    var a: numero = 0
    var b: numero = 1
    var i: numero = 0
    enquanto i < n {
        var temp: numero = a + b
        a = b
        b = temp
        i = i + 1
    }

    retorne a
}

//>puro
funcao fatorial(n: qualquer): qualquer {
    var resultado: numero = 1
    var i: numero = 2
    enquanto i <= n {
        resultado = resultado * i
        i = i + 1
    }

    retorne resultado
}

//>puro
funcao potencia(base: qualquer, expoente: qualquer): qualquer {
    var resultado: numero = 1
    var i: numero = 0
    enquanto i < expoente {
        resultado = resultado * base
        i = i + 1
    }

    retorne resultado
}

//>puro
funcao mdc(a: qualquer, b: qualquer): qualquer {
    var x: qualquer = a
    var y: qualquer = b
    enquanto !(y == 0) {
        var temp: qualquer = y
        y = x % y
        x = temp
    }

    retorne x
}

//>puro
funcao eh_primo(n: qualquer): qualquer {
    se n < 2 {
        retorne falso
    }

    var i: numero = 2
    var primo: logico = verdadeiro
    enquanto i * i <= n {
        se n % i == 0 {
            primo = falso
        }
        i = i + 1
    }

    retorne primo
}

//>puro
funcao contar_primos_ate(limite: qualquer): qualquer {
    var contagem: numero = 0
    var i: numero = 2
    enquanto i <= limite {
        se eh_primo(i) {
            contagem = contagem + 1
        }
        i = i + 1
    }

    retorne contagem
}

//>puro
funcao soma_digitos(n: qualquer): qualquer {
    var soma: numero = 0
    var atual: qualquer = n
    enquanto atual > 0 {
        soma = soma +(atual % 10)
        atual = atual \ 10
    }

    retorne soma
}

//>puro
funcao eh_palindromo_numerico(n: qualquer): qualquer {
    var original: qualquer = n
    var invertido: numero = 0
    var atual: qualquer = n
    enquanto atual > 0 {
        invertido =(invertido * 10) +(atual % 10)
        atual = atual \ 10
    }

    retorne original == invertido
}

//>puro
funcao media_ponderada(a: qualquer, b: qualquer, peso: qualquer): qualquer {
    retorne(a * peso) +(b *(1.0 - peso))
}

//>puro
funcao distancia_aproximada(dx: qualquer, dy: qualquer): qualquer {
    var soma_quadrados: qualquer =(dx * dx) +(dy * dy)
    var estimativa: real = soma_quadrados / 2.0
    var i: numero = 0
    enquanto i < 5 {
        estimativa =(estimativa +(soma_quadrados / estimativa)) / 2.0
        i = i + 1
    }

    retorne estimativa
}

//>puro
funcao combinar_metricas(n1: qualquer, n2: qualquer, n3: qualquer): qualquer {
    var passos_a: qualquer = passos_collatz(n1)
    var passos_b: qualquer = passos_collatz(n2)
    var fib: qualquer = fibonacci_iterativo(n3)
    var fat: qualquer = fatorial(6)
    var pot: qualquer = potencia(2, 10)
    var divisor: qualquer = mdc(passos_a * 4, passos_b * 6)
    var primos: qualquer = contar_primos_ate(50)
    var dig: qualquer = soma_digitos(123456789)
    var palindromo: qualquer = eh_palindromo_numerico(12321)
    var media: qualquer = media_ponderada(passos_a, passos_b, 0.65)
    var dist: qualquer = distancia_aproximada(3, 4)

    var acumulado: qualquer = fib + fat + pot + divisor + primos + dig
    var ajustado: real = acumulado -(media * 2.0) + dist

    retorne ajustado
}

// variaveis mortas em cascata: cada uma so alimenta a proxima,
// nenhuma delas jamais e usada no resultado final.
var lixo_1: qualquer = fatorial(4)
var lixo_2: qualquer = lixo_1 * potencia(2, 3)
var lixo_3: qualquer = lixo_2 + fibonacci_iterativo(10)
var lixo_4: qualquer = mdc(lixo_3, 17)
var lixo_5: qualquer = contar_primos_ate(lixo_4)

// outra cadeia morta, independente da primeira
var descartavel_a: qualquer = passos_collatz(31)
var descartavel_b: qualquer = descartavel_a * descartavel_a
var descartavel_c: qualquer = soma_digitos(descartavel_b)

var resultado_principal: qualquer = combinar_metricas(27, 97, 15)
var resultado_secundario: qualquer = combinar_metricas(6, 11, 8)

var total: qualquer = resultado_principal + resultado_secundario

escreva("Resultado principal: ", resultado_principal)
escreva("Resultado secundario: ", resultado_secundario)
escreva("Total: ", total)
escreva("Primo 97? ", eh_primo(97))
escreva("Palindromo 909? ", eh_palindromo_numerico(909))
