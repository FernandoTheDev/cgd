//! 212
// A VM preserva senão, slots locais, parâmetros mutáveis e ordem de argumentos.
//>puro
funcao escolher(condicao) {
    se condicao { retorna 1 } senao { retorna 2 }
}
//>puro
funcao combinar(a, b) { retorna a * 10 + b }
//>puro
funcao calcular() {
    var valor = 1
    se verdadeiro { var valor = 99 }
    retorna combinar(valor++, valor++)
}
escreva(escolher(falso), calcular())
