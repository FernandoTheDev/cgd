//! 47
// Os passes também visitam métodos, valores padrão e funções anônimas.
classe Medida {
    dobro(valor: qualquer = 1 + 1): qualquer {
        retorna valor * 2
    }
}

var calcular: funcao = funcao(valor: qualquer = 3 + 4): qualquer {
    retorna valor
}

escreva(Medida().dobro(), calcular())
