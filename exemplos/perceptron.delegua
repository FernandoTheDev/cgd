//# 0

var pesos = [0.3, 0.4]
var entrada = [1, 1]
var erro = 1
var resultadoEsperado = 0

enquanto (erro == 1) {
    se (entrada[0] == 1)
        se (entrada[1] == 1)
          resultadoEsperado = 1
    senão 
      resultadoEsperado = 0
    
    var somatoria = pesos[0] * entrada[0] + pesos[1] * entrada[1]
    var resultado = 0

    se (somatoria < 1) 
      resultado = 0
    senão se (somatoria >= 1) 
      resultado = 1

    escreva("resultado: ", resultado)
    erro = resultadoEsperado - resultado
    
    escreva("p1: ", pesos[0])
    escreva("p2: ", pesos[1])
    
    pesos[0] =  0.1 * entrada[0] * erro + pesos[0]
    pesos[1] =  0.1 * entrada[1] * erro + pesos[1]
    
    escreva("erro: ", erro)
}
