//! resultado: 42
funcao full_adder(a: qualquer, b: qualquer, c: qualquer): qualquer {
    var cin: qualquer = c[0]
    var axb: qualquer = a ^ b
    var sum: qualquer = axb ^ cin
    var c1: qualquer = a & b
    var c2: qualquer = cin & axb
    c[0] = c1 | c2
    retorne sum
}

funcao add_bits(A: qualquer, B: qualquer): qualquer {
    var resultado: numero = 0
    var carry: qualquer[] = [0]

    var i: numero = 0
    enquanto (i < 32) {
        var a_bits: qualquer =(A >> i) & 1
        var b_bits: qualquer =(B >> i) & 1
        var sum_bit: qualquer = full_adder(a_bits, b_bits, carry)
        resultado = resultado |(sum_bit << i++)
    }

    retorne resultado
}

var a: numero = 27
var b: numero = 15
escreva("resultado: ", add_bits(a, b))
