//!
// Fase 1 + Fase 6 (concatenacao de strings adjacentes): Lexer C99 completo com dicionarios.
// Suporta inteiros dec/hex/octal com sufixos u/l/ll, ponto flutuante (3.14, 1e-3),
// escapes \n/\t/\0/\xHH, operadores compostos e todas as keywords C99.

classe TokenC99 {
    tag: qualquer
    lexema: texto
    linha: inteiro
    coluna: inteiro
    valorInt: inteiro
    valorReal: real
    ehSemSinal: logico
    ehLongo: logico

    construtor(tag: qualquer, lexema: texto, linha: inteiro, coluna: inteiro) {
        isto.tag = tag
        isto.lexema = lexema
        isto.linha = linha
        isto.coluna = coluna
        isto.valorInt = 0
        isto.valorReal = 0.0
        isto.ehSemSinal = falso
        isto.ehLongo = falso
    }
}

funcao codigoAsciiChar(ch: texto): inteiro {
    const tabela: texto = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
    se (ch == "\n") retorna 10
    se (ch == "\t") retorna 9
    se (ch == "\r") retorna 13
    para (var i: inteiro = 0; i < tabela.tamanho(); i++) {
        se (tabela[i] == ch) retorna 32 + i
    }

    retorna 0
}

funcao hexDigito(ch: texto): inteiro {
    const hex: texto = "0123456789abcdef"
    const lower: texto = ch.minusculo()
    para (var i: inteiro = 0; i < 16; i++) {
        se (hex[i] == lower) retorna i
    }

    retorna -1
}

funcao parseInteiroLit(lex: texto): (inteiro, logico, logico) {
    var semSinal: logico = falso
    var longo: logico = falso
    var fim: inteiro = lex.tamanho()
    enquanto (fim > 0) {
        const ch: texto = lex[fim - 1]
        se (ch == "u" ou ch == "U") {
            semSinal = verdadeiro
            fim--
        } senao se (ch == "l" ou ch == "L") {
            longo = verdadeiro
            fim--
        } senao {
            sustar
        }
    }

    var buf: texto[] = []
    para (var i: inteiro = 0; i < fim; i++) buf.empilhar(lex[i])
    const s: texto = buf.juntar("")
    se (s.tamanho() == 0) retorna tupla([0, semSinal, longo])

    var val: inteiro = 0
    se (s.tamanho() >= 2 e s[0] == "0" e (s[1] == "x" ou s[1] == "X")) {
        para (var i: inteiro = 2; i < s.tamanho(); i++) {
            const d: inteiro = hexDigito(s[i])
            se (d >= 0) val = val * 16 + d
        }
    } senao se (s.tamanho() >= 2 e s[0] == "0") {
        para (var i: inteiro = 1; i < s.tamanho(); i++) {
            val = val * 8 + inteiro(s[i])
        }
    } senao {
        val = inteiro(s)
    }

    se (val > 2147483647 ou val < -2147483648) longo = verdadeiro
    retorna tupla([val, semSinal, longo])
}

funcao parseFloatLit(lex: texto): real {
    var fim: inteiro = lex.tamanho()
    enquanto (fim > 0 e "fFlL".contem(lex[fim - 1])) fim--
    var buf: texto[] = []
    para (var i: inteiro = 0; i < fim; i++) buf.empilhar(lex[i])
    retorna real(buf.juntar(""))
}

classe LexerC99 {
    tMod: qualquer
    Tok: qualquer
    keywords: dicionario
    opsTriplos: dicionario
    opsDuplos: dicionario
    opsSimples: dicionario
    escapes: dicionario

    construtor() {
        isto.tMod = importar("tipos.delegua")
        isto.Tok = isto.tMod.TokC99

        isto.keywords = {
            "void": isto.Tok.KwVoid,
            "_Bool": isto.Tok.KwBool,
            "char": isto.Tok.KwChar,
            "short": isto.Tok.KwShort,
            "int": isto.Tok.KwInt,
            "long": isto.Tok.KwLong,
            "signed": isto.Tok.KwSigned,
            "unsigned": isto.Tok.KwUnsigned,
            "float": isto.Tok.KwFloat,
            "double": isto.Tok.KwDouble,
            "const": isto.Tok.KwConst,
            "volatile": isto.Tok.KwVolatile,
            "restrict": isto.Tok.KwRestrict,
            "inline": isto.Tok.KwInline,
            "extern": isto.Tok.KwExtern,
            "static": isto.Tok.KwStatic,
            "auto": isto.Tok.KwAuto,
            "register": isto.Tok.KwRegister,
            "struct": isto.Tok.KwStruct,
            "union": isto.Tok.KwUnion,
            "enum": isto.Tok.KwEnum,
            "typedef": isto.Tok.KwTypedef,
            "sizeof": isto.Tok.KwSizeof,
            "if": isto.Tok.KwIf,
            "else": isto.Tok.KwElse,
            "while": isto.Tok.KwWhile,
            "do": isto.Tok.KwDo,
            "for": isto.Tok.KwFor,
            "switch": isto.Tok.KwSwitch,
            "case": isto.Tok.KwCase,
            "default": isto.Tok.KwDefault,
            "break": isto.Tok.KwBreak,
            "continue": isto.Tok.KwContinue,
            "goto": isto.Tok.KwGoto,
            "return": isto.Tok.KwReturn
        }

        isto.opsTriplos = {
            "...": isto.Tok.Ellipsis,
            "<<=": isto.Tok.ShlIgual,
            ">>=": isto.Tok.ShrIgual
        }

        isto.opsDuplos = {
            "->": isto.Tok.Arrow,
            "++": isto.Tok.Inc,
            "--": isto.Tok.Dec,
            "+=": isto.Tok.MaisIgual,
            "-=": isto.Tok.MenosIgual,
            "*=": isto.Tok.VezesIgual,
            "/=": isto.Tok.DivIgual,
            "%=": isto.Tok.ModIgual,
            "&=": isto.Tok.AndIgual,
            "|=": isto.Tok.OrIgual,
            "^=": isto.Tok.XorIgual,
            "==": isto.Tok.Eq,
            "!=": isto.Tok.Neq,
            "<=": isto.Tok.Le,
            ">=": isto.Tok.Ge,
            "<<": isto.Tok.Shl,
            ">>": isto.Tok.Shr,
            "&&": isto.Tok.AndLog,
            "||": isto.Tok.OrLog
        }

        isto.opsSimples = {
            "+": isto.Tok.Mais,
            "-": isto.Tok.Menos,
            "*": isto.Tok.Vezes,
            "/": isto.Tok.Div,
            "%": isto.Tok.Mod,
            "=": isto.Tok.Igual,
            "<": isto.Tok.Lt,
            ">": isto.Tok.Gt,
            "!": isto.Tok.NotLog,
            "&": isto.Tok.BitAnd,
            "|": isto.Tok.BitOr,
            "^": isto.Tok.BitXor,
            "~": isto.Tok.BitNot,
            "?": isto.Tok.Interrog,
            ":": isto.Tok.Colon,
            ".": isto.Tok.Dot,
            "(": isto.Tok.LParen,
            ")": isto.Tok.RParen,
            "{": isto.Tok.LBrace,
            "}": isto.Tok.RBrace,
            "[": isto.Tok.LBracket,
            "]": isto.Tok.RBracket,
            ";": isto.Tok.Semi,
            ",": isto.Tok.Comma
        }

        isto.escapes = {
            "n": "\n",
            "t": "\t",
            "r": "\r",
            "\\": "\\",
            "\"": "\"",
            "'": "'"
        }
    }

    tokenizar(fonte: texto): TokenC99[] {
        var out: TokenC99[] = []
        var pos: inteiro = 0
        var linha: inteiro = 1
        var col: inteiro = 1
        const n: inteiro = fonte.tamanho()

        enquanto (pos < n) {
            const c: texto = fonte[pos]
            se (c == " " ou c == "\t" ou c == "\r") {
                pos++
                col++
                continua
            }
            se (c == "\n") {
                pos++
                linha++
                col = 1
                continua
            }
            se (c == "/" e pos + 1 < n e fonte[pos + 1] == "/") {
                enquanto (pos < n e fonte[pos] != "\n") {
                    pos++
                    col++
                }
                continua
            }
            se (c == "/" e pos + 1 < n e fonte[pos + 1] == "*") {
                pos = pos + 2
                col = col + 2
                var fechou: logico = falso
                enquanto (pos + 1 < n) {
                    se (fonte[pos] == "*" e fonte[pos + 1] == "/") {
                        pos = pos + 2
                        col = col + 2
                        fechou = verdadeiro
                        sustar
                    }
                    se (fonte[pos] == "\n") {
                        linha++
                        col = 1
                    } senao {
                        col++
                    }
                    pos++
                }
                se (!fechou) falhar isto.tMod.ErroC99("Comentario /* sem fechamento na linha ${linha}")
                continua
            }
            // Literal string "..." com concatenacao automatica de strings adjacentes (Fase 6 C99)
            se (c == "\"") {
                const colIni: inteiro = col
                pos++
                col++
                var buf: texto[] = []
                var fechou: logico = falso
                enquanto (pos < n) {
                    const ch: texto = fonte[pos]
                    pos++
                    col++
                    se (ch == "\"") {
                        fechou = verdadeiro
                        sustar
                    }
                    se (ch == "\\") {
                        se (pos >= n) falhar isto.tMod.ErroC99("Linha ${linha}: escape incompleto em string")
                        const esc: texto = fonte[pos]
                        pos++
                        col++
                        se (esc == "0") {
                            buf.empilhar("\0")
                        } senao {
                            buf.empilhar(isto.escapes.obter(esc, esc))
                        }
                    } senao {
                        buf.empilhar(ch)
                    }
                }
                se (!fechou) falhar isto.tMod.ErroC99("Linha ${linha}: string nao terminada")
                const textoNovo: texto = buf.juntar("")
                // Fase 6 C99: strings adjacentes sao concatenadas
                se (out.tamanho() > 0 e out[out.tamanho() - 1].tag == isto.Tok.StrLit) {
                    out[out.tamanho() - 1].lexema = out[out.tamanho() - 1].lexema + textoNovo
                } senao {
                    out.empilhar(TokenC99(isto.Tok.StrLit, textoNovo, linha, colIni))
                }
                continua
            }
            // Literal caractere 'A', '\n', '\0', '\x41'
            se (c == "'") {
                const colIni: inteiro = col
                pos++
                col++
                var codigo: inteiro = 0
                se (pos < n e fonte[pos] == "\\") {
                    pos++
                    col++
                    const esc: texto = fonte[pos]
                    pos++
                    col++
                    se (esc == "0") {
                        codigo = 0
                    } senao se (esc == "x" ou esc == "X") {
                        enquanto (pos < n e hexDigito(fonte[pos]) >= 0) {
                            codigo = codigo * 16 + hexDigito(fonte[pos])
                            pos++
                            col++
                        }
                    } senao {
                        codigo = codigoAsciiChar(isto.escapes.obter(esc, esc))
                    }
                } senao se (pos < n) {
                    codigo = codigoAsciiChar(fonte[pos])
                    pos++
                    col++
                }
                se (pos >= n ou fonte[pos] != "'") {
                    falhar isto.tMod.ErroC99("Linha ${linha}: literal char sem fechamento")
                }
                pos++
                col++
                const tCh: TokenC99 = TokenC99(isto.Tok.CharLit, texto(codigo), linha, colIni)
                tCh.valorInt = codigo
                out.empilhar(tCh)
                continua
            }
            // Numeros inteiros (dec/hex/octal) ou ponto flutuante (3.14, 1e-3, 2.5f)
            se ("0123456789".contem(c)) {
                const colIni: inteiro = col
                var buf: texto[] = []
                var ehFloat: logico = falso
                var ehHex: logico = falso
                se (c == "0" e pos + 1 < n e (fonte[pos + 1] == "x" ou fonte[pos + 1] == "X")) {
                    ehHex = verdadeiro
                    buf.empilhar(fonte[pos])
                    buf.empilhar(fonte[pos + 1])
                    pos = pos + 2
                    col = col + 2
                    enquanto (pos < n e "0123456789abcdefABCDEFuUlL".contem(fonte[pos])) {
                        buf.empilhar(fonte[pos])
                        pos++
                        col++
                    }
                } senao {
                    enquanto (pos < n) {
                        const ch: texto = fonte[pos]
                        se ("0123456789".contem(ch)) {
                            buf.empilhar(ch)
                            pos++
                            col++
                        } senao se (ch == "." e !ehFloat) {
                            ehFloat = verdadeiro
                            buf.empilhar(ch)
                            pos++
                            col++
                        } senao se ((ch == "e" ou ch == "E") e !ehHex) {
                            ehFloat = verdadeiro
                            buf.empilhar(ch)
                            pos++
                            col++
                            se (pos < n e (fonte[pos] == "+" ou fonte[pos] == "-")) {
                                buf.empilhar(fonte[pos])
                                pos++
                                col++
                            }
                        } senao se ("uUlLfF".contem(ch)) {
                            se (ch == "f" ou ch == "F") ehFloat = verdadeiro
                            buf.empilhar(ch)
                            pos++
                            col++
                        } senao {
                            sustar
                        }
                    }
                }
                const lexNum: texto = buf.juntar("")
                se (ehFloat) {
                    const tf: TokenC99 = TokenC99(isto.Tok.FloatLit, lexNum, linha, colIni)
                    tf.valorReal = parseFloatLit(lexNum)
                    out.empilhar(tf)
                } senao {
                    const ti: TokenC99 = TokenC99(isto.Tok.IntLit, lexNum, linha, colIni)
                    const info: (inteiro, logico, logico) = parseInteiroLit(lexNum)
                    ti.valorInt = info[0]
                    ti.ehSemSinal = info[1]
                    ti.ehLongo = info[2]
                    out.empilhar(ti)
                }
                continua
            }
            // Identificadores e keywords (consulta O(1) em dicionario)
            se ("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_".contem(c)) {
                const colIni: inteiro = col
                var buf: texto[] = []
                enquanto (pos < n e "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789".contem(fonte[pos])) {
                    buf.empilhar(fonte[pos])
                    pos++
                    col++
                }
                const w: texto = buf.juntar("")
                const tagId: qualquer = isto.keywords.obter(w, isto.Tok.Ident)
                out.empilhar(TokenC99(tagId, w, linha, colIni))
                continua
            }
            // Operadores de 3 caracteres
            se (pos + 2 < n) {
                const tri: texto = c + fonte[pos + 1] + fonte[pos + 2]
                se (isto.opsTriplos.contem(tri)) {
                    out.empilhar(TokenC99(isto.opsTriplos[tri], tri, linha, col))
                    pos = pos + 3
                    col = col + 3
                    continua
                }
            }
            // Operadores de 2 caracteres
            se (pos + 1 < n) {
                const par: texto = c + fonte[pos + 1]
                se (isto.opsDuplos.contem(par)) {
                    out.empilhar(TokenC99(isto.opsDuplos[par], par, linha, col))
                    pos = pos + 2
                    col = col + 2
                    continua
                }
            }
            // Operadores/pontuacao simples
            se (isto.opsSimples.contem(c)) {
                out.empilhar(TokenC99(isto.opsSimples[c], c, linha, col))
                pos++
                col++
                continua
            }
            falhar isto.tMod.ErroC99("Linha ${linha}:${col}: caractere invalido '${c}'")
        }
        out.empilhar(TokenC99(isto.Tok.Fim, "", linha, col))
        retorna out
    }
}

funcao tokenizarC99(fonte: texto): TokenC99[] {
    retorna LexerC99().tokenizar(fonte)
}
