//! 84\nverdadeiro
classe Base {
    protegido {
        x: numero
    }

    construtor(x: qualquer) {
        isto.x = x
    }

    valor(): qualquer {
        retorna isto.x
    }
}

classe Filha herda Base {
    construtor(x: qualquer) {
        super(x + 1)
    }

    valor(): qualquer {
        retorna super.valor() * 2
    }

    dado(): qualquer {
        retorna isto.x
    }
}

var filha: Filha = Filha(3)
var metodo: funcao = filha.valor // Receptor explícito, gerenciado pelo GC.
escreva(metodo(), filha.dado())
escreva(filha.eInstanciaDe(Base))
