//! minimo\n9
@minimo(valor = 0)
classe Medida {
    lado: numero
}

escreva(decoradores(Medida).classe[0].nome)
funcao alternativa(): qualquer {
    retorna 9
}

funcao de decorador trocar(original: qualquer): qualquer {
    retorna alternativa
}

@trocar
funcao obter(): qualquer {
    retorna 1
}

escreva(obter())
