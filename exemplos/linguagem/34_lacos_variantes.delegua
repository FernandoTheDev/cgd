//! [1, 2]\n[2, 4]\n[2, 1]
var i: numero = 0
var primeiro: qualquer[] = fazer {
    i++;
    retorna i
}

enquanto i < 2
var segundo: qualquer[] = para cada valor: inteiro em [1, 2] {
    retorna valor * 2
}

var terceiro: qualquer[] = enquanto i > 0 {
    retorna i--
}

escreva(primeiro)
escreva(segundo)
escreva(terceiro)
