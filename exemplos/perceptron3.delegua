// ============================================
// FUNCOES PURAS
// ============================================

//>puro
funcao absoluto(x: numero): numero {
    se (x < 0) retorna -x
    retorna x
}

//>puro
funcao quadrado(x: numero): numero {
    retorna x * x
}

//>puro
funcao minimo(a: numero, b: numero): numero {
    se (a < b) retorna a
    retorna b
}

//>puro
funcao maximo(a: numero, b: numero): numero {
    se (a > b) retorna a
    retorna b
}

//>puro
funcao limitar(x: numero, inferior: numero, superior: numero): numero {
    retorna minimo(maximo(x, inferior), superior)
}

funcao raizQuadrada(x: numero): numero {
    se (x <= 0) retorna 0

    var estimativa: numero = x
    se (x < 1) estimativa = 1

    para (var i = 0; i < 24; i++) {
        estimativa = (estimativa + x / estimativa) / 2
    }

    retorna estimativa
}

funcao potenciaInteira(base: numero, expoente: numero): numero {
    var resultado: numero = 1

    para (var i = 0; i < expoente; i++) {
        resultado *= base
    }

    retorna resultado
}

// Aproximacao racional saturada de tanh.
//>puro
funcao tanhAproximada(x: numero): numero {
    se (x >= 3) retorna 1
    se (x <= -3) retorna -1

    const x2 = x * x
    retorna x * (27 + x2) / (27 + 9 * x2)
}

funcao derivadaTanh(x: numero): numero {
    se (x >= 3 ou x <= -3) retorna 0

    const x2 = x * x
    const x4 = x2 * x2

    const numerador = 729 - 162 * x2 + 9 * x4
    const denominador = 27 + 9 * x2

    retorna numerador / quadrado(denominador)
}

//>puro
funcao sigmoid(x: numero): numero {
    retorna (tanhAproximada(x / 2) + 1) / 2
}

funcao derivadaSigmoid(x: numero): numero {
    retorna derivadaTanh(x / 2) / 4
}

//>puro
funcao erroQuadratico(previsto: numero, esperado: numero): numero {
    retorna quadrado(previsto - esperado)
}

//>puro
funcao classificar(probabilidade: numero): numero {
    se (probabilidade >= 0.5) retorna 1
    retorna 0
}

//>puro
funcao proximoEstado(seed: numero): numero {
    retorna (seed * 16807) % 2147483647
}

//>puro
funcao normalizarEstado(seed: numero): numero {
    retorna seed / 2147483647
}

// Paridade calculada sem operadores bitwise.
//>puro
funcao paridade3(a: numero, b: numero, c: numero): numero {
    retorna (a + b + c) % 2
}

//>puro
funcao paridade4(a: numero, b: numero, c: numero, d: numero): numero {
    retorna (a + b + c + d) % 2
}

// ============================================
// TESTES MATEMATICOS E CTFE
// ============================================

funcao testarMatematica() {
    escreva("=== Testes matematicos ===")

    escreva("quadrado(12): ${quadrado(12)}")
    escreva("potencia(2, 10): ${potenciaInteira(2, 10)}")
    escreva("raiz(144): ${raizQuadrada(144)}")
    escreva("limitar(15, 0, 10): ${limitar(15, 0, 10)}")
    escreva("paridade3(1, 0, 1): ${paridade3(1, 0, 1)}")

    // Diferencas finitas para validar derivadas.
    const epsilon = 0.00001

    para (var i = -2; i <= 2; i++) {
        const x = i * 0.5

        const numerica =
        (tanhAproximada(x + epsilon) - tanhAproximada(x - epsilon)) /
        (2 * epsilon)

        const analitica = derivadaTanh(x)

        escreva("x=${x} | derivada=${analitica}" + " | numerica=${numerica}" + " | diferenca=${absoluto(analitica - numerica)}")
    }
}

// ============================================
// GERADOR PSEUDOALEATORIO
// ============================================

classe RNG {
    estado: numero

    construtor(seed: numero) {
        isto.estado = seed
    }

    proximo(): numero {
        isto.estado = proximoEstado(isto.estado)
        retorna normalizarEstado(isto.estado)
    }

    intervalo(a: numero, b: numero): numero {
        retorna a + (b - a) * isto.proximo()
    }

    indice(limite: numero): numero {
        // Evita depender de inteiro() ou floor().
        const valor = isto.proximo() * limite
        var resultado: numero = 0

        enquanto (resultado + 1 <= valor) {
            resultado++
        }

        retorna resultado
    }
}

// ============================================
// CAMADA DENSA
// ============================================

classe Camada {
    entradas: numero
    neuronios: numero

    pesos: qualquer[]
    bias: numero[]

    gradPesos: qualquer[]
    gradBias: numero[]

    mPesos: qualquer[]
    vPesos: qualquer[]

    mBias: numero[]
    vBias: numero[]

    ultimaEntrada: numero[]
    z: numero[]
    saida: numero[]

    construtor(entradas: numero, neuronios: numero, rng: RNG) {
        isto.entradas = entradas
        isto.neuronios = neuronios

        isto.pesos = []
        isto.bias = []

        isto.gradPesos = []
        isto.gradBias = []

        isto.mPesos = []
        isto.vPesos = []

        isto.mBias = []
        isto.vBias = []

        isto.ultimaEntrada = []
        isto.z = []
        isto.saida = []

        const escala = raizQuadrada(2 / entradas)

        para (var i = 0; i < neuronios; i++) {
            var linha: numero[] = []
            var grad: numero[] = []
            var momento: numero[] = []
            var variancia: numero[] = []

            para (var j = 0; j < entradas; j++) {
                linha.empilhar(rng.intervalo(-escala, escala))
                grad.empilhar(0)
                momento.empilhar(0)
                variancia.empilhar(0)
            }

            isto.pesos.empilhar(linha)
            isto.gradPesos.empilhar(grad)
            isto.mPesos.empilhar(momento)
            isto.vPesos.empilhar(variancia)

            isto.bias.empilhar(0)
            isto.gradBias.empilhar(0)
            isto.mBias.empilhar(0)
            isto.vBias.empilhar(0)
        }
    }

    frente(entrada: numero[], ultima: logico): numero[] {
        isto.ultimaEntrada = entrada
        isto.z = []
        isto.saida = []

        para (var i = 0; i < isto.neuronios; i++) {
            var soma: numero = isto.bias[i]

            para (var j = 0; j < isto.entradas; j++) {
                soma += isto.pesos[i][j] * entrada[j]
            }

            isto.z.empilhar(soma)

            se (ultima) {
                isto.saida.empilhar(sigmoid(soma))
            } senão {
                isto.saida.empilhar(tanhAproximada(soma))
            }
        }

        retorna isto.saida
    }

    acumular(delta: numero[]): numero[] {
        var gradEntrada: numero[] = []

        para (var j = 0; j < isto.entradas; j++) {
            var soma: numero = 0

            para (var i = 0; i < isto.neuronios; i++) {
                soma += isto.pesos[i][j] * delta[i]
            }

            gradEntrada.empilhar(soma)
        }

        para (var i = 0; i < isto.neuronios; i++) {
            isto.gradBias[i] += delta[i]

            para (var j = 0; j < isto.entradas; j++) {
                isto.gradPesos[i][j] +=
                delta[i] * isto.ultimaEntrada[j]
            }
        }

        retorna gradEntrada
    }

    limparGradientes() {
        para (var i = 0; i < isto.neuronios; i++) {
            isto.gradBias[i] = 0

            para (var j = 0; j < isto.entradas; j++) {
                isto.gradPesos[i][j] = 0
            }
        }
    }

    atualizar(taxa: numero, beta1: numero, beta2: numero, correcao1: numero, correcao2: numero,
        epsilon: numero, l2: numero, batch: numero, clip: numero) {
        para (var i = 0; i < isto.neuronios; i++) {
            const gb = limitar(isto.gradBias[i] / batch, -clip, clip)

            isto.mBias[i] =
            beta1 * isto.mBias[i] +
            (1 - beta1) * gb

            isto.vBias[i] =
            beta2 * isto.vBias[i] +
            (1 - beta2) * quadrado(gb)

            const mb = isto.mBias[i] / correcao1
            const vb = isto.vBias[i] / correcao2

            isto.bias[i] -=
            taxa * mb / (raizQuadrada(vb) + epsilon)

            para (var j = 0; j < isto.entradas; j++) {
                const peso = isto.pesos[i][j]

                const g = limitar(isto.gradPesos[i][j] / batch + l2 * peso, -clip, clip)

                isto.mPesos[i][j] =
                beta1 * isto.mPesos[i][j] +
                (1 - beta1) * g

                isto.vPesos[i][j] =
                beta2 * isto.vPesos[i][j] +
                (1 - beta2) * quadrado(g)

                const m = isto.mPesos[i][j] / correcao1
                const v = isto.vPesos[i][j] / correcao2

                isto.pesos[i][j] -=
                taxa * m / (raizQuadrada(v) + epsilon)
            }
        }

        isto.limparGradientes()
    }
}

// ============================================
// REDE NEURAL
// ============================================

classe RedeNeural {
    camadas: qualquer[]

    taxa: numero
    beta1: numero
    beta2: numero
    epsilon: numero
    l2: numero
    clip: numero

    passo: numero
    potenciaBeta1: numero
    potenciaBeta2: numero

    construtor(arquitetura: numero[], taxa: numero, seed: numero) {
        isto.camadas = []

        isto.taxa = taxa
        isto.beta1 = 0.9
        isto.beta2 = 0.999
        isto.epsilon = 0.00000001
        isto.l2 = 0.00001
        isto.clip = 5

        isto.passo = 0
        isto.potenciaBeta1 = 1
        isto.potenciaBeta2 = 1

        const rng = RNG(seed)

        para (var i = 1; i < arquitetura.tamanho(); i++) {
            isto.camadas.empilhar(Camada(arquitetura[i - 1], arquitetura[i], rng))
        }
    }

    frente(entrada: numero[]): numero[] {
        var atual: numero[] = entrada

        para (var i = 0; i < isto.camadas.tamanho(); i++) {
            const ultima = i == isto.camadas.tamanho() - 1
            atual = isto.camadas[i].frente(atual, ultima)
        }

        retorna atual
    }

    prever(entrada: numero[]): numero[] {
        retorna isto.frente(entrada)
    }

    perda(saida: numero[], esperado: numero[]): numero {
        var soma: numero = 0

        para (var i = 0; i < saida.tamanho(); i++) {
            soma += erroQuadratico(saida[i], esperado[i])
        }

        retorna soma / saida.tamanho()
    }

    retropropagar(esperado: numero[]) {
        const n = isto.camadas.tamanho()
        const ultima = isto.camadas[n - 1]

        var delta: numero[] = []

        para (var i = 0; i < ultima.neuronios; i++) {
            const erro = ultima.saida[i] - esperado[i]
            const grad = 2 * erro / ultima.neuronios

            delta.empilhar(grad * derivadaSigmoid(ultima.z[i]))
        }

        var indice = n - 1

        enquanto (indice >= 0) {
            const camada = isto.camadas[indice]
            const gradEntrada = camada.acumular(delta)

            indice--

            se (indice >= 0) {
                const anterior = isto.camadas[indice]
                var proximoDelta: numero[] = []

                para (var j = 0; j < anterior.neuronios; j++) {
                    proximoDelta.empilhar(gradEntrada[j] * derivadaTanh(anterior.z[j]))
                }

                delta = proximoDelta
            }
        }
    }

    aplicarGradientes(batch: numero) {
        isto.passo++

        isto.potenciaBeta1 *= isto.beta1
        isto.potenciaBeta2 *= isto.beta2

        const correcao1 = 1 - isto.potenciaBeta1
        const correcao2 = 1 - isto.potenciaBeta2

        para (var i = 0; i < isto.camadas.tamanho(); i++) {
            isto.camadas[i].atualizar(isto.taxa, isto.beta1, isto.beta2, correcao1, correcao2,
                isto.epsilon, isto.l2, batch, isto.clip)
        }
    }

    avaliar(entradas: qualquer[], alvos: qualquer[]): numero[] {
        var perdaTotal: numero = 0
        var acertos: numero = 0

        para (var i = 0; i < entradas.tamanho(); i++) {
            const saida = isto.prever(entradas[i])
            perdaTotal += isto.perda(saida, alvos[i])

            se (classificar(saida[0]) == alvos[i][0]) {
                acertos++
            }
        }

        retorna [perdaTotal / entradas.tamanho(), 100 * acertos / entradas.tamanho()]
    }

    treinar(entradas: qualquer[], alvos: qualquer[], maxEpocas: numero, tamanhoBatch: numero,
        paciencia: numero) {
        const quantidade = entradas.tamanho()
        const rng = RNG(777)

        var indices: numero[] = []

        para (var i = 0; i < quantidade; i++) {
            indices.empilhar(i)
        }

        var melhorPerda: numero = 999999
        var semMelhoria: numero = 0

        para (var epoca = 0; epoca < maxEpocas; epoca++) {
            // Fisher-Yates
            var k = quantidade - 1

            enquanto (k > 0) {
                const j = rng.indice(k + 1)
                const temp = indices[k]

                indices[k] = indices[j]
                indices[j] = temp
                k--
            }

            var acumulados: numero = 0

            para (var p = 0; p < quantidade; p++) {
                const indice = indices[p]

                isto.frente(entradas[indice])
                isto.retropropagar(alvos[indice])

                acumulados++

                se (acumulados == tamanhoBatch ou p == quantidade - 1) {
                    isto.aplicarGradientes(acumulados)
                    acumulados = 0
                }
            }

            // Avaliacao apos atualizar os pesos.
            const metricas = isto.avaliar(entradas, alvos)
            const mse = metricas[0]
            const acuracia = metricas[1]

            se (epoca % 100 == 0 ou epoca == maxEpocas - 1) {
                escreva("Epoca ${epoca} | MSE: ${mse}" + " | Acuracia: ${acuracia}%")
            }

            // Melhoria minima para evitar oscilacoes.
            se (mse < melhorPerda - 0.000001) {
                melhorPerda = mse
                semMelhoria = 0
            } senão {
                semMelhoria++
            }

            se (mse < 0.0002 e acuracia == 100) {
                escreva("Convergencia na epoca ${epoca}")
                sustar
            }

            se (semMelhoria >= paciencia) {
                escreva("Early stopping na epoca ${epoca}")
                sustar
            }
        }
    }
}

// ============================================
// DATASET
// ============================================

classe Dataset {
    entradas: qualquer[]
    alvos: qualquer[]

    construtor() {
        isto.entradas = []
        isto.alvos = []
    }

    adicionar(entrada: numero[], alvo: numero) {
        isto.entradas.empilhar(entrada)
        isto.alvos.empilhar([alvo])
    }

    gerarXOR3() {
        para (var a = 0; a <= 1; a++) {
            para (var b = 0; b <= 1; b++) {
                para (var c = 0; c <= 1; c++) {
                    isto.adicionar([a, b, c], paridade3(a, b, c))
                }
            }
        }
    }

    gerarXOR4() {
        para (var a = 0; a <= 1; a++) {
            para (var b = 0; b <= 1; b++) {
                para (var c = 0; c <= 1; c++) {
                    para (var d = 0; d <= 1; d++) {
                        isto.adicionar([a, b, c, d], paridade4(a, b, c, d))
                    }
                }
            }
        }
    }
}

// ============================================
// EXECUCAO
// ============================================

testarMatematica()

const dataset = Dataset()

// Comece pelo XOR3, ja validado anteriormente.
dataset.gerarXOR3()

const rede = RedeNeural([3, 5, 4, 1], 0.01, 12345)

escreva("\n=== Treinamento ===")

rede.treinar(dataset.entradas, dataset.alvos, 10000, 4, 1000)

escreva("\n=== Resultados ===")

var acertos: numero = 0

para (var i = 0; i < dataset.entradas.tamanho(); i++) {
    const entrada = dataset.entradas[i]
    const alvo = dataset.alvos[i][0]

    const probabilidade = rede.prever(entrada)[0]
    const predicao = classificar(probabilidade)

    se (predicao == alvo) acertos++

    escreva("${entrada} -> ${predicao}" + " | esperado: ${alvo}" + " | probabilidade: ${probabilidade}")
}

escreva("\nAcertos: ${acertos}/${dataset.entradas.tamanho()}")
