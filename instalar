#!/bin/sh
# Instala uma cópia autocontida; nenhum pacote do sistema é instalado automaticamente.
set -eu

project_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
install_prefix=${CGD_PREFIX:-${XDG_DATA_HOME:-$HOME/.local/share}/cgd}
install_bin_dir=${CGD_BIN_DIR:-$HOME/.local/bin}
build_profile=release
build_required=1
d_compiler=${DC:-}

usage() {
    cat <<'EOF'
Uso: ./instalar [--compiler dmd|ldc2] [--prefix DIRETORIO] [--bin-dir DIRETORIO]
                  [--release|--debug] [--no-build]

--no-build reutiliza cgd e lib/libdelegua_rt.o já compilados e validados.
O diretório --prefix contém o executável, o runtime e os headers.
O diretório --bin-dir recebe um link simbólico chamado cgd.
EOF
}

fail() {
    printf 'Erro: %s\n' "$*" >&2
    exit 1
}
while [ "$#" -gt 0 ]; do
    case "$1" in
    --compiler | --prefix | --bin-dir)
        [ "$#" -ge 2 ] || fail "Falta valor para $1."
        case "$1" in
        --compiler) d_compiler=$2 ;;
        --prefix) install_prefix=$2 ;;
        --bin-dir) install_bin_dir=$2 ;;
        esac
        shift 2
        ;;
    --release | -r)
        build_profile=release
        shift
        ;;
    --debug)
        build_profile=debug
        shift
        ;;
    --no-build)
        build_required=0
        shift
        ;;
    --help | -h)
        usage
        exit 0
        ;;
    *) fail "Opção desconhecida: $1" ;;
    esac
done

command -v pkg-config >/dev/null 2>&1 || fail 'Instale pkg-config.'
pkg-config --exists bdw-gc || fail 'Instale os headers e a biblioteca Boehm GC (bdw-gc).'
cd "$project_dir"
if [ "$build_required" -eq 1 ]; then
    command -v dub >/dev/null 2>&1 || fail 'Instale DUB.'
    if [ -z "$d_compiler" ]; then
        if command -v ldc2 >/dev/null 2>&1; then
            d_compiler=ldc2
        elif command -v dmd >/dev/null 2>&1; then
            d_compiler=dmd
        else fail 'Instale DMD ou LDC2.'; fi
    fi
    command -v "$d_compiler" >/dev/null 2>&1 || fail "Compilador D ausente: $d_compiler"
    if [ ! -f vendor/delegua-runtime/src/delegua_rt.h ]; then
        git submodule update --init --recursive
    fi
    ./build-runtime
    dub build --compiler="$d_compiler" --build="$build_profile" --config=application
fi
[ -x cgd ] || fail 'Executável cgd ausente. Execute dub build.'
[ -f lib/libdelegua_rt.o ] || fail 'Runtime ausente. Execute ./build-runtime.'

mkdir -p "$install_prefix/lib" "$install_prefix/vendor/delegua-runtime/src" "$install_bin_dir"
# Caminhos absolutos tornam o link independente do diretório de execução.
install_prefix=$(CDPATH= cd -- "$install_prefix" && pwd)
install_bin_dir=$(CDPATH= cd -- "$install_bin_dir" && pwd)
[ ! -d "$install_bin_dir/cgd" ] || fail 'O destino do link cgd é um diretório.'
cp cgd "$install_prefix/.cgd-install-$$"
chmod +x "$install_prefix/.cgd-install-$$"
mv -f "$install_prefix/.cgd-install-$$" "$install_prefix/cgd"
cp lib/libdelegua_rt.o "$install_prefix/lib/"
cp vendor/delegua-runtime/src/*.h "$install_prefix/vendor/delegua-runtime/src/"
if [ "$install_bin_dir/cgd" != "$install_prefix/cgd" ]; then
    ln -sf "$install_prefix/cgd" "$install_bin_dir/cgd"
fi
printf 'Instalado: %s/cgd\nRuntime: %s/lib/libdelegua_rt.o\n' "$install_bin_dir" "$install_prefix"
printf 'Inclua %s no PATH, se necessário.\n' "$install_bin_dir"
