#!/bin/sh
set -e

BIN_NAME="cgd"
REPO_URL="https://github.com/fernandothedev/cgd.git"
MAIN_DIR="$HOME/.cgd"
LIBS_DIR="$MAIN_DIR/libs"
RUNTIME_DIR="$MAIN_DIR/rt"
INSTALL_DIR="$HOME/.local/bin"

# Cores
VERDE='\033[0;32m'
VERMELHO='\033[0;31m'
AZUL='\033[0;34m'
AMARELO='\033[1;33m'
NC='\033[0m'

info() { printf "${AZUL}[INFO]${NC} %s\n" "$1"; }
aviso() { printf "${AMARELO}[AVISO]${NC} %s\n" "$1"; }
erro() { printf "${VERMELHO}[ERRO]${NC} %s\n" "$1" >&2; exit 1; }
sucesso() { printf "${VERDE}[SUCESSO]${NC} %s\n" "$1"; }

# --- Detecção do Sistema Operacional ---
PKG_MGR=""
INSTALL_CMD=""
OS_ID="desconhecido"

if [ -f /etc/os-release ]; then
    # Importa as variáveis do os-release com segurança
    . /etc/os-release
    OS_ID=$ID
fi

case "$OS_ID" in
    ubuntu|debian|linuxmint|pop)
        PKG_MGR="apt"
        INSTALL_CMD="sudo apt update && sudo apt install -y"
        ;;
    fedora)
        PKG_MGR="dnf"
        INSTALL_CMD="sudo dnf install -y"
        ;;
    arch|manjaro|endeavouros)
        PKG_MGR="pacman"
        INSTALL_CMD="sudo pacman -S --needed"
        ;;
    opensuse*)
        PKG_MGR="zypper"
        INSTALL_CMD="sudo zypper in"
        ;;
esac

# Função auxiliar para checar dependências e sugerir instalação
check_dep() {
    CMD=$1
    PKG_NAME=$2
    if ! command -v "$CMD" >/dev/null 2>&1; then
        aviso "Comando '$CMD' não encontrado."
        if [ -n "$INSTALL_CMD" ]; then
            info "Para instalar no seu sistema ($OS_ID), tente:"
            printf "  ${AMARELO}%s %s${NC}\n" "$INSTALL_CMD" "$PKG_NAME"
        fi
        erro "Dependência ausente: $CMD. Abortando."
    fi
}

# --- 1. Validação de Dependências Básicas ---
info "Verificando dependências de build..."

check_dep "git" "git"
check_dep "ldc2" "ldc"
check_dep "dub" "dub"

if ! command -v cc >/dev/null 2>&1 && ! command -v gcc >/dev/null 2>&1 && ! command -v clang >/dev/null 2>&1 && ! command -v tcc >/dev/null 2>&1; then
    aviso "Nenhum compilador C encontrado."
    if [ "$PKG_MGR" = "apt" ]; then check_dep "gcc" "build-essential";
    elif [ "$PKG_MGR" = "pacman" ]; then check_dep "gcc" "base-devel";
    else check_dep "gcc" "gcc clang"; fi
fi

# --- 2. Setup do Código-Fonte (Local ou Clone em /tmp) ---
CLONED=0
ORIGINAL_DIR=$(pwd)

# Define uma função de limpeza que rodará ao final do script (ou se ele quebrar)
cleanup() {
    if [ "$CLONED" -eq 1 ] && [ -n "$TMP_BUILD_DIR" ] && [ -d "$TMP_BUILD_DIR" ]; then
        info "Limpando repositório temporário em $TMP_BUILD_DIR..."
        rm -rf "$TMP_BUILD_DIR"
    fi
}
trap cleanup EXIT INT TERM

if [ ! -f "dub.json" ]; then
    aviso "dub.json não encontrado no diretório atual."
    
    TMP_BUILD_DIR=$(mktemp -d -t cgd_build_XXXXXX)
    info "Clonando o repositório em diretório temporário ($TMP_BUILD_DIR)..."
    
    git clone --recurse-submodules "$REPO_URL" "$TMP_BUILD_DIR"
    cd "$TMP_BUILD_DIR" || erro "Não foi possível acessar o diretório clonado."
    CLONED=1

    if [ ! -f "dub.json" ] && [ ! -f "dub.sdl" ]; then
        erro "O repositório clonado não parece ser um projeto D válido (falta dub.json)."
    fi
else
    info "dub.json encontrado localmente. Usando código atual."
fi

# --- 3. Preparação do Ambiente CGD ---
info "Garantindo diretórios de execução em $MAIN_DIR..."
mkdir -p "$LIBS_DIR"
mkdir -p "$RUNTIME_DIR"
mkdir -p "$INSTALL_DIR"

# --- 4. Configuração das Flags de Compilação ---
DUB_FLAGS="--compiler=ldc2"

if [ "$1" = "--release" ] || [ "$1" = "-r" ]; then
    info "Modo RELEASE ativado. Otimizando compilação..."
    DUB_FLAGS="$DUB_FLAGS --build=release"
else
    info "Modo DEBUG ativado. (Use '$0 --release' para versão de produção)."
fi

# --- 5. Compilação ---
info "Iniciando compilação (DUB)..."
dub build $DUB_FLAGS

if [ ! -f "$BIN_NAME" ]; then
    erro "Falha silenciosa: Binário '$BIN_NAME' não gerado."
fi

# --- 6. Instalação ---
info "Construindo o runtime da linguagem..."
./build-runtime

info "Instalando biblioteca do runtime em $LIBS_DIR..."
cp lib/libdelegua_rt.o "$LIBS_DIR/"

info "Instalando headers do runtime em $RUNTIME_DIR..."
# Copia os arquivos .h (e .c, se necessário) para a pasta de runtime global
cp vendor/delegua-runtime/src/* "$RUNTIME_DIR/"

info "Instalando executável em $INSTALL_DIR..."
cp "$BIN_NAME" "$INSTALL_DIR/"
chmod +x "$INSTALL_DIR/$BIN_NAME"

sucesso "Compilador '$BIN_NAME' instalado perfeitamente!"
sucesso "Verifique se $INSTALL_DIR está no seu \$PATH."
