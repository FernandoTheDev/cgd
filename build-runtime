#!/bin/sh
set -e

cd vendor/delegua-runtime

# Proteção 1: Só tenta o pull se for um repositório git legítimo
if [ -d ".git" ]; then
    # Proteção 2: O '|| true' impede que o 'set -e' mate o script se estiver offline ou der conflito
    git pull origin dev --rebase > /dev/null 2>&1 || true
fi

./build
cp libdelegua_rt.o ../../lib
cd ../..

if [ "$1" = "add" ]; then
    git add vendor/delegua-runtime
fi
