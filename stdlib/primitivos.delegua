importa { len, alloc, free } de "core_builtin"

// Tipo base para todos os primitivos
classe tipo_base {
    type_id: i32;
    size: i32;
    
    fn tipo_nome(): string {
        // Implementação baseada em type_id
    }
}

classe void : tipo_base {
    construtor(): void {
        isto.type_id = 0;
        isto.size = 0;
        retorna isto;
    }
    
    fn (): void* {
        retorna nulo;
    }
}

