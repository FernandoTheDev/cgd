classe Inteiro {
    valor: i32;

    construtor(valor: i32) {
        isto.valor = valor
    }

    get(): i32 {
        retorna isto.valor
    }
}

classe Texto {
    valor: i8p;

    construtor(valor: i8p) {
        isto.valor = valor
    }

    get(): i8p {
        retorna isto.valor
    }

    tamanho(): Inteiro {
        // retorna novo Inteiro(__builtin_core_strlen(isto.valor))
        retorna novo Inteiro(8)
    }
}

var nome: Texto = novo Texto("Fernando")
printf("Nome: %s\nTamanho do nome: %d\n", nome.get(), nome.tamanho().get())
// printf("Nome: %s\nTamanho do nome: %d\n", nome, nome.tamanho())
